{
  "name": "satotek-blog",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run generate-summaries && vp dev . --port 3000",
    "generate-summaries": "bun scripts/generate-post-summaries.ts",
    "generate-ogp": "bun scripts/generate-ogp.tsx",
    "generate-ogp:all": "bun run generate-ogp -- --all",
    "generate-ogp:upload": "bun run generate-ogp -- --all --upload",
    "upload-media": "bun scripts/upload-media.ts",
    "generate-routes": "tsr generate",
    "prepare": "vp config",
    "format": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "build": "bun run generate-summaries && vp build .",
    "preview": "vp preview .",
    "check": "bun run generate-summaries && vp check",
    "deploy": "bun run check && bun run test && bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.30.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@cloudflare/vite-plugin": "^1.54.5",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@satotek/content-pipeline": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.34",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0",
    "webmcp-types": "^0.1.7",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.3.13"
}
