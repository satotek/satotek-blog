{
  "name": "satotek-blog",
  "private": true,
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run generate-summaries && vp dev . --port 3000",
    "generate-summaries": "bun scripts/generate-post-summaries.ts",
    "generate-ogp": "bun scripts/generate-ogp.tsx",
    "generate-ogp:all": "bun run generate-ogp -- --all",
    "generate-ogp:upload": "bun run generate-ogp -- --all --upload",
    "upload-media": "bun scripts/upload-media.ts",
    "generate-routes": "tsr generate",
    "prepare": "vp config",
    "format": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "build": "bun run generate-summaries && vp build .",
    "preview": "vp preview .",
    "check": "bun run generate-summaries && vp check",
    "deploy": "bun run check && bun run test && bun run build && wrangler deploy && wrangler deploy -c workers/api/wrangler.jsonc",
    "deploy:api": "wrangler deploy -c workers/api/wrangler.jsonc",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@satotek/blog-core": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@satotek/content-pipeline": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "webmcp-types": "^0.1.10",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
