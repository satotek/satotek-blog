{
  "name": "satotek-blog",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm run generate-summaries && vp dev --port 3000",
    "build": "pnpm run generate-summaries && vp build",
    "preview": "vp preview --port 3000",
    "check": "pnpm run generate-summaries && vp check",
    "format": "vp fmt",
    "test": "pnpm run generate-summaries && vp test run",
    "deploy": "pnpm run check && pnpm run test && void deploy",
    "generate-summaries": "node scripts/run.ts scripts/generate-post-summaries.ts",
    "generate-ogp": "node scripts/run.ts scripts/generate-ogp.tsx",
    "generate-ogp:all": "pnpm run generate-ogp --all",
    "generate-ogp:upload": "pnpm run generate-ogp --all --upload",
    "upload-media": "node scripts/run.ts scripts/upload-media.ts",
    "prepare": "vp config && void prepare",
    "secrets:push": "node scripts/push-secrets.ts"
  },
  "dependencies": {
    "hono": "^4.13.21",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.38.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@void/react": "1.11.0",
    "@wooorm/starry-night": "^3.11.0",
    "cf": "1.0.0-rc.4",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "1.11.0",
    "webmcp-types": "^0.2.0",
    "wrangler": "^4.166.0"
  },
  "packageManager": "pnpm@12.23.0"
}
