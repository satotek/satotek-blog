{
  "name": "satotek-blog",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run generate-content && vp dev . --port 3000",
    "generate-content": "bun scripts/generate-post-content.ts",
    "generate-ogp": "bun scripts/generate-ogp.tsx",
    "generate-ogp:all": "bun run generate-ogp -- --all",
    "generate-ogp:upload": "bun run generate-ogp -- --all --upload",
    "upload-media": "bun scripts/upload-media.ts",
    "generate-routes": "tsr generate",
    "prepare": "vp config",
    "build": "bun run generate-content && vp build .",
    "preview": "vp preview .",
    "typecheck": "tsc --noEmit && bun run --filter '@satotek/content-pipeline' typecheck",
    "check": "bun run generate-content && vp check src packages scripts && bun run typecheck",
    "deploy": "bun run check && bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.28.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@resvg/resvg-js": "^2.6.2",
    "@satotek/content-pipeline": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.32",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "satori": "^0.33.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9",
    "wrangler": "^4.125.0"
  },
  "packageManager": "bun@1.3.13"
}
