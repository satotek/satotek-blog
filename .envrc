use flake

# 隠さなくてよい値。ビルドに埋め込む VITE_* もここに置く。
dotenv public.env

# 隠す値は sops（GCP KMS）で暗号化して Git に置き、復号した値は環境変数にだけ載せる。
# 平文のファイルは作らない。復号には gcloud の application-default 認証が要る。
# 失敗時のメッセージに値が混ざらないよう、sops と jq の出力はどちらも捨てる。
if has sops && has jq && [ -f secrets.sops.env ]; then
  watch_file secrets.sops.env
  if exports="$(sops --decrypt --output-type json secrets.sops.env 2>/dev/null |
    jq -r 'to_entries[] | "export \(.key)=\(.value | @sh)"' 2>/dev/null)" && [ -n "$exports" ]; then
    eval "$exports"
    # void dev は .env にあるキーだけをローカルの Worker に渡し、値はシェルのもので上書きする。
    # そのためキー名だけを並べた .env を作る。値は書かないので、平文の秘密は残らない。
    sops --decrypt --output-type json secrets.sops.env 2>/dev/null |
      jq -r 'keys[] | "\(.)="' >.env 2>/dev/null
  else
    log_error "secrets.sops.env を読み込めませんでした（gcloud auth application-default login を確認）"
  fi
  unset exports
fi
