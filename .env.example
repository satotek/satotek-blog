# Production GA4 measurement ID. Required for bun run deploy of satotek.dev.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public base URL for generated article OGP images.
VITE_OGP_BASE_URL=https://img.satotek.dev

# Public base URL for article and site media stored in R2.
VITE_MEDIA_BASE_URL=https://img.satotek.dev

# Server-only GA4 Data API credentials. Do not prefix these with VITE_.
# For local Cloudflare development, .dev.vars is preferred.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
